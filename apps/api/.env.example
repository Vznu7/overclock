# OVERCLOCK API Local Environment Template
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16+ with Row-Level Security)
# Application connects as non-superuser 'overclock_app' to enforce RLS
DATABASE_URL=postgresql+psycopg://overclock_app:overclock_app_password@localhost:5433/overclock

# Security & Authentication
SECRET_KEY=development-secret-key-at-least-32-chars-long-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Object Storage (MinIO / S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=overclock-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# AI Provider
LLM_PROVIDER=mock
OPENAI_API_KEY=
