# OVERCLOCK Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

# Frontend Public API URL
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=overclock
POSTGRES_PASSWORD=overclock_dev_password
POSTGRES_DB=overclock
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://overclock:overclock_dev_password@localhost:5432/overclock

# Security & Authentication
SECRET_KEY=development-secret-key-at-least-32-chars-long-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Object Storage (MinIO Local / Supabase S3 / Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=overclock-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# AI Provider Configuration
# Set to 'mock' for zero cost, reproducible tests and local evaluation
# Set to 'openai' for production/cloud evaluations with a real API key
LLM_PROVIDER=mock
OPENAI_API_KEY=
MODEL_EXTRACT_PRIMARY=gpt-4o-mini
MODEL_EXTRACT_ESCALATION=gpt-4o
MODEL_EXPLAIN=gpt-4o-mini

# AI Usage Guardrails (INR)
DEFAULT_MONTHLY_AI_BUDGET_INR=500.00
GLOBAL_DAILY_AI_CAP_INR=50.00

# Locale & Standards
TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DATE_FORMAT=DD-MM-YYYY
